  "locations.index": {
    "summary": "Discover approved locations by distance",
    "tag": "Catalogue",
    "response": "LocationPage",
    "statuses": [
      200
    ],
    "paginate": true,
    "query": [
      {
        "name": "latitude",
        "in": "query",
        "required": true,
        "schema": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      {
        "name": "longitude",
        "in": "query",
        "required": true,
        "schema": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      {
        "name": "radius",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    ]
  },
