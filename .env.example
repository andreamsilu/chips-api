APP_NAME=MloExpress
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mloexpress
DB_USERNAME=mloexpress
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Exact client origins; no wildcard with credentials.
CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_SECURE_COOKIE=true
TOKEN_EXPIRY_MINUTES=10080
REDIS_QUEUE_RETRY_AFTER=90

# Configure privately in a secret manager; never expose these to Flutter/Next.js bundles.
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_WEBHOOK_URL=
SNIPPE_PAYOUTS_ENABLED=false

# NextSMS v2: backend-only token and approved sender ID.
# For Basic-auth v1, set NEXT_SMS_AUTHORIZATION privately and use the v1 URL.
NEXTSMS_ENABLED=false
NEXTSMS_API_TOKEN=
NEXTSMS_SENDER_ID=
NEXT_SMS_AUTHORIZATION=
NEXT_SMS_API_URL=https://messaging-service.co.tz/api/sms/v2/text/single
NEXT_SMS_SENDER_ID=

DELIVERY_BASE_FEE=2000
DELIVERY_PER_KM=500
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

# Separate backend key: Routes, Places (New), Geocoding; restrict to server IP.
GOOGLE_MAPS_SERVER_KEY=
# Enable persistent route caching only when permitted by your Google agreement.
GOOGLE_MAPS_ROUTE_CACHE_SECONDS=0
GOOGLE_MAPS_CANDIDATE_LIMIT=25
DELIVERY_MAXIMUM_DISTANCE_METERS=50000

GOOGLE_MAPS_REQUESTS_PER_MINUTE=300

# Optional guest capability lifetimes (minutes)
GUEST_SESSION_TTL_MINUTES=10080
GUEST_ORDER_TTL_MINUTES=43200
