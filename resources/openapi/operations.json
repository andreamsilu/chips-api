  "products.index": {
    "summary": "List available location products",
    "tag": "Catalogue",
    "response": "ProductPage",
    "statuses": [
      200
    ],
    "paginate": true,
    "query": [
      {
        "name": "search",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 100
        }
      },
      {
        "name": "category_id",
        "in": "query",
        "schema": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "example": "01K9N7T0W0ZQVADXX1W34XFZZZ"
        }
      }
    ]
  },
